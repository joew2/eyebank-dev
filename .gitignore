# Allowlist project sources: do not track the installed WordPress environment.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/deliverables/
!/eyecanseeagain_static_site/
!/wp-content/
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/eyedonation/
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/eyedonation-search/
!/wp-content/plugins/eyedonation-migrations/

# Reproducible output and environment-specific records.
/deliverables/*.png
/deliverables/LOCAL-*
/deliverables/PACKAGE-CHECKSUMS.json
*.zip
.DS_Store
._*
Thumbs.db
node_modules/
vendor/
.cache/
coverage/

# Credentials, machine configuration, logs and database/server backups.
.env
.env.*
wp-config*.php
*.sql
*.sql.*
*.log
*.pem
*.key
*.p12
*.pfx
*.bak
*.backup
*.tar
*.tar.gz
*.tgz

# Locally authored site plugins (explicitly reviewed).
!/wp-content/plugins/custom-user-info-url.php
!/wp-content/plugins/custom-disable-layout-metaboxes/
!/wp-content/plugins/custom-disable-menu-links-for-creators/
!/wp-content/plugins/custom-donor-family-survey/
!/wp-content/plugins/custom-es-donor-family-survey/
!/wp-content/plugins/custom-family-survey-colums/
!/wp-content/plugins/custom-social-icons.php
!/wp-content/plugins/custom-top-links-english-site/
!/wp-content/plugins/custom-translation-navigation-links/

# Combined locally authored accessibility and translation widget.
!/wp-content/plugins/custom-accessibility-translation/

# Design references stay local; deployable assets live in the theme.
/Spec/

# Locally authored newsletter archive and administration.
!/wp-content/plugins/custom-newsletters/

# Theme-independent tracking integrations.
!/wp-content/plugins/custom-site-tracking/

# Separate one-button portal and member-page repairs.
!/wp-content/plugins/custom-site-repairs/

# Targeted portal placement correction.
!/wp-content/plugins/custom-portal-navigation-fix/

# Independent, repeatable homepage-only restore.
!/wp-content/plugins/custom-homepage-restore/

# General site-specific Toolset customizations.
!/wp-content/plugins/custom-toolset-mods/

# Standalone legacy boards password-recovery migration.
!/wp-content/plugins/custom-forgot-password-boards/

# Mobile-only donor-card sizing and hero placement migration.
!/wp-content/plugins/custom-mobile-donor-panel/

# Responsive homepage recipients/families photo framing migration.
!/wp-content/plugins/custom-resource-photo-framing/

# Bundled desktop/mobile replacement photos for the Resources card.
!/wp-content/plugins/custom-resource-card-images/

# Mobile-only Resources card height follow-up.
!/wp-content/plugins/custom-mobile-resource-card-height/

# Bundled mobile-v3 Resources photo follow-up.
!/wp-content/plugins/custom-mobile-resource-image/

# Content-only landing page template migration.
!/wp-content/plugins/custom-landing-no-header-footer/

# Homepage history background and layout migration.
!/wp-content/plugins/custom-homepage-history/

# Required temporary compatibility layer while Thrive landing pages remain.
!/wp-content/plugins/custom-thrive-compatibility-fix/
